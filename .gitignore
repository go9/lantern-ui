# Build artifacts and fetched dependencies. Reproducible from mix.lock via
# `mix deps.get` — never commit them (they polluted every diff until #961).
/_build/
/deps/
/cover/
/doc/
*.ez
lantern_ui-*.tar

# jsdom for the hook tests. package-lock.json IS committed so `npm ci` in CI
# resolves the same tree; node_modules is not.
/node_modules/

# Crash dumps
erl_crash.dump

# Editor / language server
/.elixir_ls/
/.lexical/

# Local, machine-specific config
flicker.toml
.env

# Symlinked into worktrees; a trailing-slash pattern matches a DIRECTORY,
# not a symlink, so these need bare entries too.
/deps
/_build

# agent session scratch (pi-subagents, impeccable critique)
.pi-subagents/
.impeccable/
