{
  "name": "lantern-ui-dev",
  "private": true,
  "version": "0.0.0",
  "description": "Build + test harness for priv/static/lantern_ui_hooks.js. NOT published to npm and NOT part of the Hex package (see the `files:` whitelist in mix.exs). Consumers import the committed bundle — they do not need a JS toolchain.",
  "type": "module",
  "scripts": {
    "build": "esbuild assets/js/lantern_ui_hooks.js --bundle --format=esm --outfile=priv/static/lantern_ui_hooks.js --external:./zag/select.js && esbuild assets/js/zag/select.js --bundle --format=esm --outfile=priv/static/zag/select.js",
    "test": "node --test test/js/*.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4"
  },
  "devDependencies": {
    "@zag-js/collection": "^1.44.0",
    "@zag-js/core": "^1.44.0",
    "@zag-js/popper": "^1.44.0",
    "@zag-js/select": "^1.44.0",
    "@zag-js/types": "^1.44.0",
    "@zag-js/vanilla": "^1.44.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0"
  }
}
